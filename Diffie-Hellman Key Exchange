# diffie_hellman_demo.py

p = 23
g = 5

alice_private = 6
bob_private = 15

alice_public = pow(g, alice_private, p)
bob_public = pow(g, bob_private, p)

alice_shared_key = pow(bob_public, alice_private, p)
bob_shared_key = pow(alice_public, bob_private, p)

print("=== Diffie-Hellman Key Exchange ===")
print(f"Prime (p): {p}")
print(f"Generator (g): {g}")

print(f"\nAlice Private Key : {alice_private}")
print(f"Alice Public Key  : {alice_public}")

print(f"\nBob Private Key   : {bob_private}")
print(f"Bob Public Key    : {bob_public}")

print("\n=== Shared Key ===")
print(f"Alice: {alice_shared_key}")
print(f"Bob  : {bob_shared_key}")

if alice_shared_key == bob_shared_key:
    print("\n[SUCCESS] Shared key berhasil dibuat.")
